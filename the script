; ==============================================================================
; MACRO RECORDER ENGINE
; ==============================================================================
F9::
StartRecord:
    if (IsReplaying)
        return
    IsRecording := !IsRecording
    if (IsRecording) {
        RecordedInputs := []
        GuiControl,, RecStatus2, Status: RECORDING IN PROGRESS...
        GuiControl,, HomeMacroStatus, Status: Recording...
        SetTimer, RecordMacroPos, 30
    } else {
        SetTimer, RecordMacroPos, Off
        StepCount := RecordedInputs.Length()
        GuiControl,, RecStatus2, Status: Recorded %StepCount% steps!
        GuiControl,, HomeMacroStatus, Status: Stopped
        GuiControl,, HomeMacroSteps, Recorded Steps: %StepCount%
    }
return

RecordMacroPos:
    if (!IsRecording)
        return
    MouseGetPos, xpos, ypos
    GetKeyState, lstate, LButton, P
    GetKeyState, rstate, RButton, P

    PressedKey := ""
    Loop, 256 {
        vk := Format("vk{:02X}", A_Index)
        if (GetKeyState(vk, "P")) {
            PressedKey := GetKeyName(vk)
            break
        }
    }
    RecordedInputs.Push({x: xpos, y: ypos, lb: lstate, rb: rstate, key: PressedKey})
return

F10::
StartReplay:
    Gui, Submit, NoHide
    if (IsRecording || RecordedInputs.Length() = 0) {
        GuiControl,, RecStatus2, Status: No data recorded!
        return
    }
    IsReplaying := !IsReplaying
    if (IsReplaying) {
        ReplayIndex := 1
        GuiControl,, RecStatus2, Status: REPLAYING...
        GuiControl,, HomeMacroStatus, Status: Replaying
        
        SpeedVal := (ReplaySpeedMS + 0 > 0) ? ReplaySpeedMS : 30
        SetTimer, ExecuteReplay, %SpeedVal%
    } else {
        SetTimer, ExecuteReplay, Off
        GuiControl,, RecStatus2, Status: Stopped Replay
        GuiControl,, HomeMacroStatus, Status: Ready
    }
return

ExecuteReplay:
    if (!IsReplaying)
        return
    if (ReplayIndex > RecordedInputs.Length())
        ReplayIndex := 1

    Data := RecordedInputs[ReplayIndex]
    MouseMove, % Data.x, % Data.y, 0

    if (Data.lb = "D")
        Click, Down
    else
        Click, Up

    if (Data.rb = "D")
        Click, Right, Down
    else
        Click, Right, Up

    CurKey := Data.key
    if (CurKey != "" && CurKey != "LButton" && CurKey != "RButton" && CurKey != "F10") {
        Send, {%CurKey% down}
        Sleep, 10
        Send, {%CurKey% up}
    }
    ReplayIndex++
return

ClearRecord:
    RecordedInputs := []
    GuiControl,, RecStatus2, Status: Data cleared.
    GuiControl,, HomeMacroSteps, Recorded Steps: 0
return

; ==============================================================================
; CROSSHAIR OVERLAY
; ==============================================================================
ToggleCrosshairDirect:
^+c::
    CrosshairOn := !CrosshairOn
    if (CrosshairOn) {
        Gosub, DrawCrosshair
        GuiControl,, CrosshairStatusText, Status: Enabled
    } else {
        Gui, Crosshair: Destroy
        GuiControl,, CrosshairStatusText, Status: Disabled
    }
return

CycleCrosshairDirect:
^+v::
    CrosshairColorIndex++
    if (CrosshairColorIndex > CrosshairColors.Length())
        CrosshairColorIndex := 1
    if (CrosshairOn)
        Gosub, DrawCrosshair
return

DrawCrosshair:
    Gui, Crosshair: Destroy
    Gui, Crosshair: New, +AlwaysOnTop -Caption +ToolWindow +E0x20
    ColorHex := CrosshairColors[CrosshairColorIndex]
    Gui, Crosshair: Color, %ColorHex%
    CenterX := (A_ScreenWidth / 2) - 3
    CenterY := (A_ScreenHeight / 2) - 3
    Gui, Crosshair: Show, x%CenterX% y%CenterY% w6 h6 NoActivate
return

; ==============================================================================
; WINDOW UTILITIES
; ==============================================================================
^Space:: WinSet, AlwaysOnTop, Toggle, A

#!t::
    WinGet, Transparent, Transparent, A
    if (Transparent = 180)
        WinSet, Transparent, OFF, A
    else
        WinSet, Transparent, 180, A
return

^+h:: WinMinimize, A

^+x::
    MouseGetPos, MouseX, MouseY
    PixelGetColor, color, %MouseX%, %MouseY%, RGB
    Clipboard := color
    MsgBox, 64, Color Picker, Hex Color %color% copied!
return

^+s:: Run, SnippingTool.exe /clip

^+k::
    WinGet, ActiveProcess, ProcessName, A
    if (ActiveProcess != "AutoHotkey.exe" && ActiveProcess != "explorer.exe") {
        Process, Close, %ActiveProcess%
        MsgBox, 64, Task Killer, Closed process: %ActiveProcess%
    }
return

^!c::
    FormatTime, CurrentTime,, yyyy-MM-dd HH:mm:ss
    FileAppend, [%CurrentTime%] Clip Marker Saved`n, MyClips.txt
    MsgBox, 64, Clip Marker, Saved timestamp to MyClips.txt!
return

