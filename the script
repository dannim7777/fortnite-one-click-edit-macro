UpdateDashboardStats:
    VarSetCapacity(memStatus, 64, 0)
    NumPut(64, memStatus, 0, "UInt")
    DllCall("Kernel32.dll\GlobalMemoryStatusEx", "Ptr", &memStatus)
    memLoad := NumGet(memStatus, 4, "UInt")
    GuiControl,, HomeRamStats, System RAM: %memLoad%`% Used
return

UpdateMacroSpeed:
    Gui, Submit, NoHide
    MacroSpeedMS := MacroSlider
    SpeedText := MacroSpeedMS . " ms"
    GuiControl,, SpeedDisplay, %SpeedText%
return

EnableFortniteMacro:
    MacroEnabled := True
    GuiControl,, HomeFortniteMacroStatus, Status: EDIT MACRO ACTIVE (ON)
    GuiControl,, DedicatedMacroStatus, Status: ACTIVE (Hold F for Single Edit | Hold I for Spam)
return

DisableFortniteMacro:
