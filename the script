LookupRoblox:
    Gui, Submit, NoHide
    if (LookupUser != "")
        Run, https://www.roblox.com/search/users?keyword=%LookupUser%
return

BoostRoblox:
    Process, Priority, RobloxPlayerBeta.exe, High
    MsgBox, 64, FPS Booster, Set Roblox priority to High!
return

BoostFortnite:
    Process, Priority, FortniteClient-Win64-Shipping.exe, High
    MsgBox, 64, FPS Booster, Set Fortnite priority to High!
return

TestPing:
    GuiControl,, PingResultsPage, Testing ping...
    RunWait, %ComSpec% /c ping google.com -n 2 > "%A_Temp%\ping_res.txt",, Hide
    FileRead, PingData, %A_Temp%\ping_res.txt
    RegExMatch(PingData, "Average = (\d+ms)", Match)
    if (Match1 != "") {
        CurrentPing := Match1
        GuiControl,, HomePingStats, Ping: %Match1%
    }
return

LaunchRoblox:
    Run, roblox://
return

LaunchChrome:
    Run, chrome.exe
return

LaunchDiscord:
    Run, discord.exe
return

LaunchNotepad:
    Run, notepad.exe
return

SaveSettings:
    Gui, Submit, NoHide
    if (OptAlwaysOnTop)
        Gui, +AlwaysOnTop
    else
        Gui, -AlwaysOnTop
    MsgBox, 64, Settings, Preferences saved!
return

GuiClose:
    ExitApp
