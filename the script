; ==============================================================================
; FORTNITE EDIT MACRO ENGINE
; ==============================================================================

; --- HOLD 'F' (SINGLE-KEY HOLD EDIT MACRO) ---
$f::
    if (!MacroEnabled) {
        SendInput, f
        return
    }
    SendInput {f down}
    DllCall("Sleep", "UInt", 1)
    SendInput {f up}
    SendInput {l down}
    
    KeyWait, f
    SendInput {l up}
return

; --- HOLD 'I' (SPAM EDIT MACRO MODE) ---
$i::
    if (!MacroEnabled) {
        SendInput, i
        return
    }
    While GetKeyState("i", "P") {
        SendInput, f
        if (MacroSpeedMS > 0)
            DllCall("Sleep", "UInt", MacroSpeedMS)
        SendInput, g
        if (MacroSpeedMS > 0)
            DllCall("Sleep", "UInt", MacroSpeedMS)
        SendInput, l
        if (MacroSpeedMS > 0)
            DllCall("Sleep", "UInt", MacroSpeedMS)
    }
return

; --- TOGGLE HOTKEY (F8) ---
F8::
    MacroEnabled := !MacroEnabled
    if (MacroEnabled) {
        GuiControl,, HomeFortniteMacroStatus, Status: EDIT MACRO ACTIVE (ON)
        GuiControl,, DedicatedMacroStatus, Status: ACTIVE (Hold F for Single Edit | Hold I for Spam)
        SoundBeep, 750, 80
    } else {
        GuiControl,, HomeFortniteMacroStatus, Status: EDIT MACRO DISABLED (OFF)
        GuiControl,, DedicatedMacroStatus, Status: DISABLED (Press F8 to Turn ON)
        SoundBeep, 300, 80
    }
return

